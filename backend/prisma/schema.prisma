// OHARA data model. Database: Supabase Postgres.
// DATABASE_URL = pooled (6543, pgbouncer=true) for runtime; DIRECT_URL = 5432 for migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  PATIENT
  CAREGIVER
  HEALTH_WORKER
  ADMIN
}

enum ReminderKind {
  MEDICINE
  WATER
  MEAL
  WALK
  APPOINTMENT
}

enum OccurrenceStatus {
  PENDING
  DONE
  SNOOZED
  MISSED
}

enum AlertType {
  DECLINE
  MISSED_DOSE
  SOS
  INACTIVITY
  INFO
}

enum Severity {
  INFO
  WARN
  CRITICAL
}

enum MediaKind {
  PHOTO
  VOICE
}

enum NotificationChannel {
  PUSH
  EMAIL
  SMS
}

enum PackStatus {
  PLANNED
  DRAFT
  PUBLISHED
}

enum ContentCategory {
  OBJECT
  SOUND
  FOOD
  FESTIVAL
  ROUTINE
}

// ---------- People & auth ----------

model User {
  id              String    @id @default(cuid())
  // At least one of email / phone is set. Phone is E.164, e.g. "+919876543210".
  email           String?   @unique
  phone           String?   @unique
  name            String?
  role            Role      @default(CAREGIVER)
  activePatientId String?
  createdAt       DateTime  @default(now())
  lastLoginAt     DateTime?

  memberships   CareTeamMember[]
  refreshTokens RefreshToken[]
  pushSubs      PushSubscription[]
  acks          Alert[]            @relation("AlertAckBy")
  auditLogs     AuditLog[]
  consents      Consent[]
  visitNotes    VisitNote[]
}

model OtpCode {
  id         String   @id @default(cuid())
  // Normalised email address or E.164 phone number the code was sent to.
  identifier String   @map("email")
  codeHash   String
  expiresAt  DateTime
  attempts   Int      @default(0)
  consumed   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- Patient & care team ----------

model Patient {
  id           String    @id @default(cuid())
  displayName  String
  fullName     String?
  age          Int?
  place        String?
  language     String    @default("English")
  timezone     String    @default("Asia/Kolkata")
  // Elder may answer reminders by saying "Done" (needs network for ASR).
  voiceAnswers Boolean   @default(true)
  photoMediaId String?
  voiceMediaId String?
  // Soft delete; the purge job removes everything 30 days later.
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  team          CareTeamMember[]
  devices       Device[]
  reminders     Reminder[]
  occurrences   ReminderOccurrence[]
  events        ReminderEvent[]
  alerts        Alert[]
  family        FamilyMember[]
  media         MediaItem[]
  sessions      GameSession[]
  baselines     Baseline[]
  consents      Consent[]
  pairingCodes  PairingCode[]
  auditLogs     AuditLog[]
  visitNotes    VisitNote[]
  notifications NotificationLog[]
}

model CareTeamMember {
  id          String   @id @default(cuid())
  patientId   String
  userId      String
  // Display "role" in the UI, e.g. "Daughter · Guwahati"
  relation    String?
  memberRole  Role     @default(CAREGIVER)
  permissions String[]
  isOwner     Boolean  @default(false)
  hue         String   @default("violet")
  notifyEmail Boolean  @default(true)
  notifySms   Boolean  @default(true)
  createdAt   DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([patientId, userId])
}

model Consent {
  id          String    @id @default(cuid())
  patientId   String
  grantedById String
  // care_data (covers reminders, games, analytics) | reminders | games | analytics | location
  scope       String    @default("care_data")
  guardian    Boolean   @default(true)
  text        String?
  grantedAt   DateTime  @default(now())
  revokedAt   DateTime?

  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  grantedBy User    @relation(fields: [grantedById], references: [id], onDelete: Cascade)

  @@index([patientId, scope])
}

// ---------- Patient device (the tablet/phone the elder uses) ----------

model Device {
  id         String    @id @default(cuid())
  patientId  String
  label      String?
  model      String?
  appVersion String?
  lastSeenAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  patient  Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  pushSubs PushSubscription[]
}

model PairingCode {
  id          String    @id @default(cuid())
  // Device-generated codes are stored as typed; caregiver-generated 6-digit codes are stored as a hash.
  code        String    @unique
  secretHash  String
  expiresAt   DateTime
  patientId   String?
  deviceId    String?
  claimedAt   DateTime?
  // Set when the device has collected its token once
  deliveredAt DateTime?
  // Set for caregiver-generated codes
  createdById String?
  deviceModel String?
  appVersion  String?
  createdAt   DateTime  @default(now())

  patient Patient? @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    String?
  deviceId  String?
  createdAt DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}

// ---------- Reminders ----------

model Reminder {
  id            String       @id @default(cuid())
  patientId     String
  kind          ReminderKind
  time          String // "HH:MM" in the patient's timezone
  title         String
  detail        String       @default("")
  // Whose voice plays it, e.g. "Rina"
  voiceBy       String       @default("")
  voiceMediaId  String?
  photoMediaId  String?
  // 0 = Sunday … 6 = Saturday; empty = every day
  daysOfWeek    Int[]
  active        Boolean      @default(true)
  // "Alert me if missed": push, then SMS and email to the care team.
  alertIfMissed Boolean      @default(true)
  clientId      String?      @unique
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  patient     Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  occurrences ReminderOccurrence[]
  events      ReminderEvent[]

  @@index([patientId])
}

model ReminderOccurrence {
  id                  String           @id @default(cuid())
  reminderId          String
  patientId           String
  // Local calendar date "YYYY-MM-DD" in the patient's timezone
  date                String
  dueAt               DateTime
  status              OccurrenceStatus @default(PENDING)
  snoozedUntil        DateTime?
  snoozeCount         Int              @default(0)
  notifiedAt          DateTime?
  // Second ring, REPEAT_AFTER_MIN after the first
  repeatedAt          DateTime?
  caregiverNotifiedAt DateTime?
  smsAt               DateTime?
  emailedAt           DateTime?
  completedAt         DateTime?
  updatedAt           DateTime         @updatedAt

  reminder Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  patient  Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([reminderId, date])
  @@index([status, dueAt])
  @@index([patientId, date])
}

model ReminderEvent {
  id         String           @id @default(cuid())
  reminderId String
  patientId  String
  date       String
  status     OccurrenceStatus
  clientId   String?          @unique
  at         DateTime         @default(now())

  reminder Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  patient  Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, at])
}

// ---------- Alerts ----------

model Alert {
  id             String    @id @default(cuid())
  patientId      String
  type           AlertType
  severity       Severity
  title          String
  detail         String    @default("")
  clientId       String?   @unique
  acknowledged   Boolean   @default(false)
  acknowledgedAt DateTime?
  acknowledgedBy String?
  resolved       Boolean   @default(false)
  resolvedAt     DateTime?
  resolvedBy     String?
  resolutionNote String?
  // SOS location { lat, lng, accuracy } (stored only with location consent)
  location       Json?
  // Source of the alert, used for escalation and de-duplication
  occurrenceId   String?
  deviceId       String?
  createdAt      DateTime  @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  ackBy   User?   @relation("AlertAckBy", fields: [acknowledgedBy], references: [id], onDelete: SetNull)

  @@index([patientId, createdAt])
  @@index([occurrenceId])
}

// ---------- Notifications ----------

// One row per email / SMS sent to the care team.
model NotificationLog {
  id        String              @id @default(cuid())
  patientId String?
  alertId   String?
  channel   NotificationChannel
  // Masked recipient (never the full email or number)
  recipient String
  ok        Boolean
  error     String?
  createdAt DateTime            @default(now())

  patient Patient? @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, createdAt])
}

// ---------- Family & media ----------

model FamilyMember {
  id           String   @id @default(cuid())
  patientId    String
  name         String
  relation     String
  place        String   @default("")
  hue          String   @default("violet")
  memory       String   @default("")
  photoMediaId String?
  voiceMediaId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}

model MediaItem {
  id           String    @id @default(cuid())
  patientId    String
  kind         MediaKind
  // Cloudinary public_id and resource_type ("image" | "video" — audio is stored as video)
  publicId     String    @unique
  resourceType String
  format       String?
  bytes        Int?
  label        String?
  personName   String?
  // e.g. "praise" (played after a game), "greeting", "reminder"
  purpose      String?
  uploadedBy   String?
  createdAt    DateTime  @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}

// ---------- Games & baselines ----------

model GameSession {
  id             String   @id @default(cuid())
  patientId      String
  gameId         String
  level          Int
  accuracy       Float
  responseTimeMs Int
  hintsUsed      Int      @default(0)
  rounds         Int      @default(0)
  durationMs     Int      @default(0)
  playedAt       DateTime @default(now())
  clientId       String?  @unique

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, playedAt])
}

model Baseline {
  id         String   @id @default(cuid())
  patientId  String
  // "accuracy" | "responseTimeMs" | "activityMinutes"
  metric     String
  median     Float
  ewma       Float
  std        Float
  sampleSize Int
  computedAt DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([patientId, metric])
}

// ---------- Health worker visits ----------

model VisitNote {
  id        String   @id @default(cuid())
  patientId String
  authorId  String?
  text      String
  visitedAt DateTime @default(now())
  createdAt DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  author  User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([patientId, visitedAt])
}

// ---------- Culture packs (admin content for games) ----------

model CulturePack {
  id          String     @id @default(cuid())
  // Region slug, e.g. "assam", "bodoland", "manipur"
  region      String     @unique
  name        String
  // Languages that must have audio for every item, e.g. ["as", "hi", "en"]
  languages   String[]
  status      PackStatus @default(DRAFT)
  // Latest published version (0 = never published)
  version     Int        @default(0)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  items    ContentItem[]
  versions CulturePackVersion[]
}

model ContentItem {
  id        String          @id @default(cuid())
  packId    String
  category  ContentCategory
  label     String
  // Label per language code
  labels    Json            @default("{}")
  tags      String[]
  // Cloudinary public id or an https URL
  image     String?
  // Audio per language code: { "<lang>": "<public id or https URL>" }
  audio     Json            @default("{}")
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  pack CulturePack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@index([packId, category])
}

// Immutable snapshot of a pack at publish time; phones download the latest one on sync.
model CulturePackVersion {
  id          String   @id @default(cuid())
  packId      String
  version     Int
  items       Json
  publishedAt DateTime @default(now())

  pack CulturePack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@unique([packId, version])
}

// ---------- Audit ----------

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  patientId String?
  action    String
  meta      Json?
  createdAt DateTime @default(now())

  actor   User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  patient Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([patientId, createdAt])
}
