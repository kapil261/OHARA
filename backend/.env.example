# Copy to .env and fill in. Never commit .env.
# Every service below has a free tier. Anything left blank falls back gracefully (see README).

NODE_ENV=development
PORT=4000
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
# Public URL of the frontend (used in invite emails)
APP_URL=http://localhost:5173
DEFAULT_TIMEZONE=Asia/Kolkata

# --- Supabase Postgres (Project settings → Database → Connection string) ---
# Pooled connection (Supavisor, transaction mode, port 6543) used by the app at runtime
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct/session connection (port 5432) used by prisma migrate / db push
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
DEVICE_TOKEN_DAYS=180
OTP_TTL_MIN=10
OTP_MAX_ATTEMPTS=5

# --- Email (free SMTP: Gmail app password, Brevo free 300/day, or Ethereal for testing) ---
# Leave SMTP_HOST empty in dev: emails (and OTP codes) are printed to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="OHARA <no-reply@example.com>"

# --- Cloudinary (free plan) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ohara

# --- Web Push (free, self-hosted VAPID). Generate with: npm run vapid:keys ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- ML service (Anya's FastAPI, ai/) ---
ML_URL=
ML_TIMEOUT_MS=3000

# --- Bhashini voice (free government API, optional) ---
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd

# --- Reminder escalation ---
MISSED_AFTER_MIN=15
EMAIL_AFTER_MIN=30
ENABLE_JOBS=true
