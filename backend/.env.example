# Copy to .env and fill in. Never commit .env.
# (prod) = the API refuses to start in production without it. Everything else is optional and falls back gracefully.

# --- Server ---
# development | test | production. Production enables secure cookies and strict startup checks.
NODE_ENV=development
# Port the API listens on (most hosts inject PORT themselves).
PORT=4000
# Comma-separated frontend origins allowed to call the API with cookies (exact match, no trailing slash).
CORS_ORIGINS=http://localhost:5173
# Public URL of the frontend, used for links in invite emails.
APP_URL=http://localhost:5173
# Fallback timezone for patients and reminders.
DEFAULT_TIMEZONE=Asia/Kolkata
# Log level: fatal | error | warn | info | debug | trace | silent. Default: info in prod, debug in dev.
LOG_LEVEL=

# --- Database: Supabase Postgres (Project settings > Database > Connection string) ---
# (prod) Pooled connection (Supavisor transaction mode, port 6543) used by the app at runtime.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct/session connection (port 5432) used only by `prisma migrate deploy`.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Auth ---
# (prod) JWT signing secret, at least 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Caregiver access-token lifetime (refreshed silently via the httpOnly refresh cookie).
ACCESS_TOKEN_TTL=15m
# Refresh-token (cookie) lifetime in days.
REFRESH_TOKEN_DAYS=30
# Lifetime of the patient device token in days.
DEVICE_TOKEN_DAYS=180
# Sign-in code lifetime in minutes.
OTP_TTL_MIN=10
# Wrong guesses allowed per sign-in code before it is burned.
OTP_MAX_ATTEMPTS=5

# --- Email / SMTP (Gmail app password, Brevo free 300/day, or Ethereal for testing) ---
# (prod) SMTP server. Leave empty in dev only: emails and sign-in codes are then printed to the console.
SMTP_HOST=
# 587 for STARTTLS, 465 for implicit TLS.
SMTP_PORT=587
# true only for port 465.
SMTP_SECURE=false
# SMTP username.
SMTP_USER=
# SMTP password or app password.
SMTP_PASS=
# Sender shown on emails; must be allowed by your SMTP provider.
MAIL_FROM="OHARA <no-reply@example.com>"

# --- Cloudinary (photos and voice clips; free plan) ---
# Cloud name from the Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=
# API key from the Cloudinary dashboard.
CLOUDINARY_API_KEY=
# API secret from the Cloudinary dashboard (server only).
CLOUDINARY_API_SECRET=
# Folder that uploads are stored under.
CLOUDINARY_FOLDER=ohara

# --- Web Push (self-hosted VAPID). Generate both keys with: npm run vapid:keys ---
# Public VAPID key (also given to the frontend).
VAPID_PUBLIC_KEY=
# Private VAPID key (server only).
VAPID_PRIVATE_KEY=
# Contact for push services, as mailto: or https: URL.
VAPID_SUBJECT=mailto:admin@example.com

# --- AI service (Anya's FastAPI in ai/) ---
# Base URL of the AI service. Blank = not deployed; the backend uses its local heuristics.
ML_URL=
# Shared secret sent as the X-ML-Key header. (prod, when ML_URL is set) Must equal ML_API_KEY on the AI service.
ML_API_KEY=
# Timeout for /difficulty and /decline calls before falling back locally (ms).
ML_TIMEOUT_MS=3000
# Timeout for the AI /health probe used by GET /api/health (ms).
ML_HEALTH_TIMEOUT_MS=1500

# --- Bhashini voice (free government API, optional) ---
# Bhashini ULCA user id.
BHASHINI_USER_ID=
# Bhashini ULCA API key.
BHASHINI_API_KEY=
# Bhashini pipeline id (default is the public MeitY pipeline).
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd

# --- SMS: MSG91 (sign-in codes by SMS, alert SMS to the care team). Leave blank to disable. ---
# Indian SMS needs DLT-approved templates: create them in MSG91, then paste the template ids here.
# (prod) Either this or SMTP_HOST must be set. MSG91 auth key (server only).
MSG91_AUTH_KEY=
# DLT sender id (6 letters), e.g. OHARAC.
MSG91_SENDER_ID=
# Flow template for sign-in codes; variables ##otp## and ##minutes##.
MSG91_OTP_TEMPLATE_ID=
# Flow template for care-team alerts and invites; variables ##var1## (patient name) and ##var2## (short text).
MSG91_ALERT_TEMPLATE_ID=

# --- Reminder escalation ladder (minutes after a reminder is due) ---
# Ring once more on the elder's phone if there is no answer.
REPEAT_AFTER_MIN=10
# Mark the reminder missed and (if "alert me if missed" is on) alert the care team by push.
MISSED_AFTER_MIN=30
# SMS the care team if nobody has acknowledged the alert yet.
SMS_AFTER_MIN=45
# Email the care team if nobody has acknowledged the alert yet.
EMAIL_AFTER_MIN=45
# How many times the elder may tap "Remind me later" for one reminder.
MAX_SNOOZES=2

# --- Other jobs ---
# Hours without contact before a "Phone offline" alert is raised.
DEVICE_SILENT_HOURS=48
# Days a deleted patient can be restored before all their data is purged.
DELETE_GRACE_DAYS=30
# Run the cron jobs (reminders, phone-offline check, nightly analysis, purge). Run them on exactly one instance.
ENABLE_JOBS=true
