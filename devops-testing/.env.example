# Copy to .env (same folder as docker-compose.yml). Never commit .env.
# Everything has a safe default for local use; the blank ones are optional.

POSTGRES_USER=ohara
POSTGRES_PASSWORD=ohara
POSTGRES_DB=ohara

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=local-dev-secret-change-me-please-0123456789

CORS_ORIGINS=http://localhost:5173
APP_URL=http://localhost:5173
VITE_API_URL=http://localhost:4000/api

# Optional: leave SMTP_HOST empty and OTP codes are printed in the backend logs (docker compose logs backend)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
BHASHINI_USER_ID=
BHASHINI_API_KEY=